# Copy to config/application-local.properties and fill in the existing DB settings.
# This file is loaded relative to the project/JAR working directory.
# Use jdbc:mariadb:, not jdbc:log4jdbc:mysql:. Use & rather than &amp; in URLs.
spring.datasource.url=jdbc:mariadb://192.168.1.12:3306/groupware9
spring.datasource.username=YOUR_MARIADB_USER
spring.datasource.password=YOUR_MARIADB_PASSWORD

spring.second-datasource.url=jdbc:as400://YOUR_DB2_HOST/DAELIMDB
spring.second-datasource.username=YOUR_DB2_USER
spring.second-datasource.password=YOUR_DB2_PASSWORD

server.port=8080
